<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/lightOrange"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".employeeSettings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:gravity="center"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_marginTop="9dp"
            android:letterSpacing="0.05"
            android:text="Settings"
            android:textColor="@color/blue"
            android:textSize="30sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/blue"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="65dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Password"
            android:textAlignment="center"
            android:textColor="@color/blue"
            android:textSize="25dp"
            android:fontFamily="sans-serif-condensed-medium"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:textAlignment="center"
            >
            <EditText
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/oldPassword"
                android:hint="Old Password"
                android:backgroundTint="@color/blue"
                android:textSize="20sp"
                />
            <EditText
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/newPassword"
                android:hint="New Password"
                android:backgroundTint="@color/blue"
                android:textSize="20sp"
                />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/blue"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:text="Confirm"
                />
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:layout_height="4dp"
                android:background="@color/blue"
                />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:letterSpacing="0.05"
            android:text="Accessibility Settings"
            android:textColor="@color/blue"
            android:textSize="25sp"
            />
        <CheckBox
            android:text="Dark Mode"
            android:textColor="@color/blue"
            android:textSize="20dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:letterSpacing="0.05"
            android:text="Font Size"
            android:textColor="@color/blue"
            android:textSize="20sp"
            />

        <CheckBox
            android:text="Small Font"
            android:textColor="@color/blue"
            android:textSize="20dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
        <CheckBox
            android:text="Standard Font"
            android:textColor="@color/blue"
            android:textSize="20dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
        <CheckBox
            android:text="Large Font"
            android:textColor="@color/blue"
            android:textSize="20dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center|bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        >
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="83dp"
        android:layout_height="81dp"
        android:background="@color/blue"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Requests"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-condensed-medium"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <Button
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:background="@drawable/form"
            android:id="@+id/hotbarRequests"
            app:backgroundTint="@color/black"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="83dp"
        android:layout_height="81dp"
        android:background="@color/offBlue"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calendar"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-condensed-medium"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <Button
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:background="@drawable/calendar"
            android:id="@+id/hotbarCalendar"
            app:backgroundTint="@color/black"

            />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="83dp"
        android:layout_height="81dp"
        android:background="@color/blue"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-condensed-medium"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <Button
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:background="@drawable/home"
            android:id="@+id/hotbarHome"
            app:backgroundTint="@color/black"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="83dp"
        android:layout_height="81dp"
        android:background="@color/offBlue"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bookings"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-condensed-medium"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <Button
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:background="@drawable/book"
            android:id="@+id/hotbarBookings"
            app:backgroundTint="@color/black"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="83dp"
        android:layout_height="81dp"
        android:background="@color/blue"
        >
        <View
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:background="@color/lightOrange"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-condensed-medium"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <Button
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:background="@drawable/settings"
            android:id="@+id/hotbarSettings"
            app:backgroundTint="@color/black"
            />
        </LinearLayout>
    </LinearLayout>







</androidx.constraintlayout.widget.ConstraintLayout>