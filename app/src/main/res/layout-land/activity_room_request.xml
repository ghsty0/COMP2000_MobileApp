<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/lightOrange"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RoomRequest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:gravity="center"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_marginTop="9dp"
            android:letterSpacing="0.05"
            android:text="Request a Room"
            android:textColor="@color/blue"
            android:textSize="30sp"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/blue"
            />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/mainLayout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="50dp"
            android:orientation="vertical"
            android:gravity="center"
            >

            <Button
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/viewAvailability"
                android:text="View Availability"
                android:backgroundTint="@color/blue"
                android:textSize="20sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scroll for more options"
                android:fontFamily="sans-serif-condensed-medium"
                android:textSize="14sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Room: Meeting Room 1"
                android:id="@+id/selectedRoom"
                android:fontFamily="sans-serif-condensed-medium"
                android:textSize="19sp"
                />

            <ScrollView
                android:layout_width="240dp"
                android:layout_height="109dp"
                android:elevation="@dimen/cardview_default_elevation"
                android:background="@color/lightBlue"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    >
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/MR1"
                        android:text="Meeting Room 1"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/MR2"
                        android:text="Meeting Room 2"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/MR3"
                        android:text="Meeting Room 3"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/MR4"
                        android:text="Meeting Room 4"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:id="@+id/MR5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:backgroundTint="@color/blue"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:text="Meeting Room 5"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/SR1"
                        android:text="Seminar Room 1"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/SR2"
                        android:text="Seminar Room 2"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />

                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                >

                <ScrollView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:elevation="@dimen/cardview_default_elevation"
                    android:background="@color/lightBlue"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:id="@+id/startTime"
                            android:text="Start: "
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time9"
                            android:text="9AM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time10"
                            android:text="10AM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time11"
                            android:text="11AM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time12"
                            android:text="12PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />

                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time13"
                            android:text="1PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time14"
                            android:text="2PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time15"
                            android:text="3PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time16"
                            android:text="4PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/time17"
                            android:text="5PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />

                    </LinearLayout>
                </ScrollView>

                <ScrollView
                    android:layout_width="100dp"
                    android:layout_height="70dp"
                    android:elevation="@dimen/cardview_default_elevation"
                    android:background="@color/lightBlue"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:id="@+id/endTime"
                            android:text="End: "
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime10"
                            android:text="10AM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime11"
                            android:text="11AM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime12"
                            android:text="12PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />

                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime13"
                            android:text="1PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime14"
                            android:text="2PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime15"
                            android:text="3PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime16"
                            android:text="4PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime17"
                            android:text="5PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />
                        <Button
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/eTime18"
                            android:text="6PM"
                            android:backgroundTint="@color/blue"
                            android:textSize="20sp"
                            />

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <Button
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/openCalendar"
                    android:text="Choose a Day"
                    android:backgroundTint="@color/blue"
                    android:textSize="20sp"
                    />
                <Button
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/submit"
                    android:text="submit"
                    android:backgroundTint="@color/blue"
                    android:textSize="20sp"
                    />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Day: 1st Jan 1999"
                android:id="@+id/selectedDate"
                android:fontFamily="sans-serif-condensed-medium"
                android:textSize="19sp"
                />

            <DatePicker
                android:layout_width="325dp"
                android:layout_height="240dp"
                android:id="@+id/datePicker"
                android:visibility="invisible"
                android:elevation="@dimen/cardview_default_elevation"
                android:background="@color/white"
                />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center|bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@color/lightOrange"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Requests"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/form"
                android:id="@+id/hotbarRequests"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/offBlue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/calendar"
                android:id="@+id/hotbarCalendar"
                app:backgroundTint="@color/black"

                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/home"
                android:id="@+id/hotbarHome"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/offBlue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bookings"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/book"
                android:id="@+id/hotbarBookings"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/settings"
                android:id="@+id/hotbarSettings"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>


    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>