<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/lightOrange"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".employeeHomepage">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:gravity="center"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_marginTop="9dp"
            android:letterSpacing="0.05"
            android:text="Welcome,Valued Employee"
            android:textColor="@color/blue"
            android:textSize="30sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/blue"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:gravity="center"
        >

        <Button
            android:layout_marginTop="0dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/requestRoomButton"
            android:text="Request a Room"
            android:backgroundTint="@color/blue"
            android:textSize="35sp"
            />

        <Button
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/calendarButton"
            android:text="       Calendar       "
            android:backgroundTint="@color/blue"
            android:textSize="35sp"
            />

        <Button
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/bookingsButton"
            android:text="  Your Bookings  "
            android:backgroundTint="@color/blue"
            android:textSize="35sp"
            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center|bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Requests"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/form"
                android:id="@+id/hotbarRequests"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/offBlue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/calendar"
                android:id="@+id/hotbarCalendar"
                app:backgroundTint="@color/black"

                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@color/lightOrange"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/home"
                android:id="@+id/hotbarHome"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/offBlue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bookings"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/book"
                android:id="@+id/hotbarBookings"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/settings"
                android:id="@+id/hotbarSettings"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>


    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>