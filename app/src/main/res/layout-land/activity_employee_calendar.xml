<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/lightOrange"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EmployeeCalendar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:gravity="center"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_marginTop="9dp"
            android:letterSpacing="0.05"
            android:text="Calendar"
            android:textColor="@color/blue"
            android:textSize="30sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/blue"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:gravity="center"
        >

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_marginTop="55dp"
            android:letterSpacing="0.05"
            android:text="Choose a Day"
            android:id="@+id/chooseDay"
            android:backgroundTint="@color/blue"
            android:textColor="@color/white"
            android:textSize="25sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-condensed-medium"
            android:letterSpacing="0.05"
            android:text="Date Chosen: "
            android:id="@+id/selectedDate"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textSize="20sp"
            />

        <DatePicker
            android:layout_width="325dp"
            android:layout_height="190dp"
            android:id="@+id/datePicker"
            android:visibility="invisible"
            android:elevation="@dimen/cardview_default_elevation"
            android:background="@color/white"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scroll for more options"
            android:fontFamily="sans-serif-condensed-medium"
            android:textSize="14sp"
            />
        <LinearLayout
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >

            <ScrollView
                android:layout_width="100dp"
                android:layout_height="70dp"
                android:elevation="@dimen/cardview_default_elevation"
                android:background="@color/lightBlue"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:id="@+id/startTime"
                        android:text="Start: "
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time9"
                        android:text="9AM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time10"
                        android:text="10AM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time11"
                        android:text="11AM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time12"
                        android:text="12PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />

                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time13"
                        android:text="1PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time14"
                        android:text="2PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time15"
                        android:text="3PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time16"
                        android:text="4PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/time17"
                        android:text="5PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />

                </LinearLayout>
            </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
            <ScrollView
                android:layout_width="100dp"
                android:layout_height="70dp"
                android:elevation="@dimen/cardview_default_elevation"
                android:background="@color/lightBlue"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:id="@+id/endTime"
                        android:text="End: "
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime10"
                        android:text="10AM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime11"
                        android:text="11AM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime12"
                        android:text="12PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />

                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime13"
                        android:text="1PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime14"
                        android:text="2PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime15"
                        android:text="3PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime16"
                        android:text="4PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime17"
                        android:text="5PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />
                    <Button
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/eTime18"
                        android:text="6PM"
                        android:backgroundTint="@color/blue"
                        android:textSize="20sp"
                        />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <Button
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:layout_width="155dp"
                android:layout_height="wrap_content"
                android:id="@+id/roomSearch"
                android:text="Search for Rooms"
                android:backgroundTint="@color/blue"
                android:textSize="15sp"
                />
            <Button
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:layout_width="155dp"
                android:layout_height="wrap_content"
                android:id="@+id/bookRoom"
                android:text="Book a Room"
                android:backgroundTint="@color/blue"
                android:textSize="15sp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"

            >
            <View
                android:layout_width="wrap_content"
                android:layout_height="4dp"
                android:background="@color/blue"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:layout_height="200dp"

                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Available Room 1"
                        android:textColor="@color/black"
                        android:textSize="25dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Available Room 2"
                        android:textColor="@color/black"
                        android:textSize="25dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Available Room 3"
                        android:textColor="@color/black"
                        android:textSize="25dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Available Room 4"
                        android:textColor="@color/black"
                        android:textSize="25dp"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Available Room 5"
                        android:textColor="@color/black"
                        android:textSize="25dp"
                        android:layout_marginBottom="40dp"
                        />
                </LinearLayout>



            </ScrollView>
        </LinearLayout>





    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center|bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Requests"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/form"
                android:id="@+id/hotbarRequests"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/offBlue"
            >
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@color/lightOrange"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/calendar"
                android:id="@+id/hotbarCalendar"
                app:backgroundTint="@color/black"

                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/home"
                android:id="@+id/hotbarHome"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/offBlue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bookings"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/book"
                android:id="@+id/hotbarBookings"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:background="@color/blue"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-condensed-medium"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/settings"
                android:id="@+id/hotbarSettings"
                app:backgroundTint="@color/black"
                />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>