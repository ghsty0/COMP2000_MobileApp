<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RoomRequest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:gravity="center"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_marginTop="9dp"
            android:letterSpacing="0.05"
            android:text="Request a Room"
            android:textColor="@color/blue"
            android:textSize="30sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/blue"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"
        android:orientation="vertical"
        android:gravity="center"
        >

        <Button
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/viewAvailability"
            android:text="View Availability"
            android:backgroundTint="@color/blue"
            android:textSize="20sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Room: Meeting Room 1"
            android:id="@+id/selectedRoom"
            android:fontFamily="sans-serif-condensed-medium"
            android:textSize="19sp"
            />

        <ScrollView
            android:layout_width="256dp"
            android:layout_height="128dp"
        >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >
            <Button
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/MR1"
                android:text="Meeting Room 1"
                android:backgroundTint="@color/blue"
                android:textSize="20sp"
                />
                <Button
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/MR2"
                    android:text="Meeting Room 2"
                    android:backgroundTint="@color/blue"
                    android:textSize="20sp"
                    />
                <Button
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/MR3"
                    android:text="Meeting Room 3"
                    android:backgroundTint="@color/blue"
                    android:textSize="20sp"
                    />
                <Button
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/MR4"
                    android:text="Meeting Room 4"
                    android:backgroundTint="@color/blue"
                    android:textSize="20sp"
                    />
                <Button
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/MR5"
                    android:text="Meeting Room 5"
                    android:backgroundTint="@color/blue"
                    android:textSize="20sp"
                    />
                <Button
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/SR1"
                    android:text="Seminar Room 1"
                    android:backgroundTint="@color/blue"
                    android:textSize="20sp"
                    />
                <Button
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/SR2"
                    android:text="Seminar Room 2"
                    android:backgroundTint="@color/blue"
                    android:textSize="20sp"
                    />

            </LinearLayout>
        </ScrollView>




    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>